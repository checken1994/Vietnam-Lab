# Copy to /etc/scp/scp.env on the VPS and edit only non-secret values here.
# Never commit the real file or put passwords/tokens in this repository.

SCP_PRODUCTION_MODE=1
SCP_HOST=127.0.0.1
SCP_PORT=8000
SCP_EGRESS_MODE=deny
SCP_FORCE_HTTPS=1
SCP_AUTH_PASSWORD_FILE=/etc/scp/secrets/auth_password
# SCP_CAPABILITY_SECRET: Required for capability token HMAC signing (GAP-09).
# Generate locally, e.g. python -c "import secrets; print(secrets.token_hex(32))"
# SCP_CAPABILITY_SECRET=
# SCP_JOURNAL_SECRET: Required (R5) — K_journal for TaskKernel journal + checkpoint HMAC; must differ
# from SCP_CAPABILITY_SECRET (or mount it via SCP_JOURNAL_SECRET_FILE). Without it /ask fails closed.
# SCP_JOURNAL_SECRET=
# SCP_APPROVAL_ISSUER_PUBLIC_KEY_FILE: Ed25519 public key (base64 raw) that verifies approval tokens (R5-B).
# The matching PRIVATE key stays with the issuer, never on this host.
# SCP_APPROVAL_ISSUER_PUBLIC_KEY_FILE=

# Optional dashboard-to-service URLs. Keep internal services loopback-only.
SCP_INTERNAL_URL=http://127.0.0.1:8000
LOOP_SCHEDULER_URL=http://127.0.0.1:3030
LLM_BRIDGE_URL=http://127.0.0.1:11434

# Optional model routing. Do not put provider tokens in this file.
# Configure a server-side secret broker or a protected environment file if a
# provider integration is explicitly enabled after review.
# OPENROUTER_MODEL_CHAT=...
# OPENROUTER_MODEL_JUDGE=...
