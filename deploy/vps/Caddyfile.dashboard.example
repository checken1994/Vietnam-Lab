# Replace dashboard.example.com with a domain controlled by the operator.
# Caddy obtains and renews a public TLS certificate for a real domain.
# Do not expose Next.js dashboard directly on :3000 to the public Internet.

dashboard.example.com {
    encode gzip

    request_body {
        max_size 10MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    # Next.js Dashboard reverse proxy
    # Caddy replaces X-Forwarded-For and X-Real-IP with {remote_host},
    # preventing client-side header spoofing.
    #
    # IMPORTANT SECURITY NOTE:
    # Next.js dashboard middleware strictly restricts all `/api/scp/*` routes
    # to localhost (127.0.0.1, ::1). Remote external requests to `/api/scp/*`
    # will receive HTTP 403 by design.
    # Operators requiring remote dashboard API management should access via
    # WireGuard/tailscale VPN, SSH port forwarding, or configure Caddy mTLS.
    #
    # DEPLOYMENT REQUIREMENT — trusted-proxy shared secret:
    # Because Next 16 no longer exposes the socket peer (request.ip), a
    # directly reachable :3000 could spoof X-Forwarded-For. When
    # SCP_DASHBOARD_PROXY_SECRET is set on the Next.js process, the middleware
    # rejects every /api/scp/* request that does not carry a matching
    # `X-SCP-Proxy-Secret` header (HTTP 403). Caddy stamps that header on the
    # request to the upstream ({$ENV} is Caddy's environment-variable
    # placeholder); with the variable unset Caddy expands it to an empty
    # value and the middleware keeps its historical XFF-only behavior.
    # Rotate the secret on BOTH sides (Caddy env + Next.js env) together.
    reverse_proxy 127.0.0.1:3000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
        header_up X-SCP-Proxy-Secret {$SCP_DASHBOARD_PROXY_SECRET}
    }
}
