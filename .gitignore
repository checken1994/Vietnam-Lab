# Acceptance run dirs: everything inside stays ignored (binary/SQLite/logs),
# but the small verdict JSONs are re-included by the negations at the END of
# this file — committable acceptance evidence.
reports/scp_acceptance_ci/**
reports/acceptance_24_7/**

# Portable reality output is generated evidence, not tracked source.
reports/reality/*.json
!reports/reality/README.md
SCP_CODE_STRUCTURE_DETAILED.*
_scp_*
_inspect_*
scp-audit/
pending_fixes/

# Versioned SCP runtime source; generated bytecode/cache remains ignored.
!scp/runtime/
!scp/runtime/**
scp/runtime/**/__pycache__/
scp/runtime/**/*.pyc

tools/audit/local/

benchmark_report.txt
raw_results.jsonl

