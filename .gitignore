scp_full_ast_map.json

# Runtime data dirs
kernel-backups/
data-test/

# Agent session scratch dirs under .agents/ (regenerable, not source).
# Deliberately NOT ignored: .agents/skills/, .agents/*.md, .agents/evals* —
# new skills and agent-process docs must stay addable (A7 MED-07, 2026-10-01).
.agents/auditor_*
.agents/challenger_*
.agents/explorer_*
.agents/orchestrator_*
.agents/reviewer_*
.agents/worker_*
.agents/sentinel*
.agents/spec_miner_*
.agents/teamwork*
.agents/victory_*


# Bun local install artifacts (C-02, audit 2026-09-28)
dashboard/.bun/
mini-services/llm-bridge/.bun/

# agent verification scratch dirs
.tmp_verify/
scratch/

# Audit evidence lives under reports/ — negate the generic runtime/release and
# evidence-type excludes (*.log, *.db, *.sqlite3, ...) for it so the evidence
# chain is committed, not obscured. These negations MUST stay at the END of
# this file: git evaluates patterns in order and the last match wins, so any
# later generic exclude would re-obscure future evidence. (A7 HIGH-02, 2026-10-01)
!reports/release/
!reports/release/**
!reports/runtime/
!reports/runtime/**
# Acceptance verdict JSONs: small committable evidence (the rest of those run
# dirs — binary/SQLite/logs — stays ignored via the dir/** patterns above).
!reports/acceptance_24_7/acceptance.json
!reports/scp_acceptance_ci/*.json

# [W15 2026-10-06] full-system audit runtime artifacts (shm/wal/lock + snapshot) — Filename too long tren Windows worktree
reports/system_audit_*/
