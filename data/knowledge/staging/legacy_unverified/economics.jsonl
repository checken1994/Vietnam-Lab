{"schema_version": 1, "record_id": "staging.economics:what-is-unemployment", "domain": "economics", "entity": {"entity_id": "what-is-unemployment", "canonical_name": "what is unemployment", "aliases": ["what is unemployment", "unemployment rate"]}, "facts": {"text": "Unemployment rate is the percentage of the labor force that is without work but available for and seeking employment."}, "review": {"status": "legacy_unverified", "method": "code_extraction_staging", "origin_file": "scp/runtime/experts/economics.py", "origin_line": 46}}
