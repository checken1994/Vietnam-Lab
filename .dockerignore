# [E-W1 fix · 2026-10-23] .git KHÔNG bị loại toàn phần nữa: audit image cần
# .git thật cho 7 test (git worktree add, rev-parse HEAD, trusted base 'main').
# .git host = 729MB > ngưỡng 200MB ⇒ COPY CHỌN LỌC: HEAD/config/index/
# packed-refs/refs/objects — không logs/, hooks/, worktrees/, lost-found/,
# COMMIT_EDITMSG/FETCH_HEAD (metadata host, không cần cho test).
# garbage tmp_obj_* (~71MB, git process dở dang trên host) cũng bị loại.
# ⚠⚠ IMAGE CHỨA GIT HISTORY CỦA REPO — LOCAL-ONLY AUDIT IMAGE,
#    TUYỆT ĐỐI KHÔNG publish/push image này ra registry. ⚠⚠
.git/*
!.git/HEAD
!.git/config
!.git/index
!.git/packed-refs
!.git/refs
!.git/objects
.git/objects/*/tmp_obj_*
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
private/
**/.env
**/*.sqlite
**/*.db
**/*.jsonl
# [D-W1 fix · 2026-10-23] data/documents/canonical_seed_corpus.jsonl là seed
# corpus PRODUCT (statute valid_to/valid_from, molar mass, domain data) —
# atomic_verifier.verify_and_prune → get_canonical_fts_warehouse() auto-ingest
# thư mục này. Thiếu ⇒ statute-expiry fail-closed không detect EXPIRED ⇒ T06
# test_25/test_26 (refuted_count 0≠1), test_04/09/12/13/16 mất local resolution.
!data/documents/*.jsonl
# [F-12 fix · 2026-10-23] Một số .jsonl là DATA chạy thật của product/battery,
# không phải artifact bỏ đi: scp/runtime/question_router đọc
# scp/benchmark/iso_comprehensive.jsonl (thiếu ⇒ lookup fork hỏng trong
# container); battery audit cần benchmark/*.jsonl (gsm8k_sample_10, goldset).
!scp/benchmark/*.jsonl
!benchmark/*.jsonl
**/ragas_results*.json
**/ragas*.json
**/reports/
**/benchmark_batches/
**/local/
**/__pycache__/
**/*.pyc
# [E-W1 fix · 2026-10-23] .pytest_cache trên host ở mode dị thường 0111
# (ACL deny-read) ⇒ fsutil nhận diện sai type và pattern trailing-slash
# không match ⇒ context sender "open ... Access is denied". Pattern không
# slash match entry bất kể type, prune trước khi mở.
.pytest_cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
node_modules/
# [FIX fresh-install 2026-10-24] KHÔNG chặn node_modules bên trong .next/
# (standalone build cần .next/standalone/node_modules/ để chạy)
!.next/standalone/node_modules/
# [FIX fresh-install 2026-10-24] .next/ KHÔNG bị chặn — dashboard
# Dockerfile (single-stage) COPY .next/standalone + .next/static (build
# artifact từ `npm run build` trước). Chặn này làm fresh install fail
# "not found: /.next/static".
.next/cache/
.next/types/
dist/
build/
coverage/
